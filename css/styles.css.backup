/* CSS Variables */
:root {
    --primary-red: #FF0000;
    --primary-white: #FFFFFF;
    --dark-gray: #333333;
    --light-gray: #f0f0f0;
    --glass-bg: rgba(255, 255, 255, 0.1);
    --glass-border: rgba(255, 255, 255, 0.2);
    --glass-blur: 10px;
}

/* Reset and base styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--primary-white);
    color: var(--dark-gray);
    overflow-x: hidden;
    cursor: none; /* We'll use custom cursor */
}

.binary-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    background-image: url('../assets/binary-pattern.svg');
    background-repeat: repeat;
}

/* Custom Cursor */
#cursor {
    position: fixed;
    width: 32px;
    height: 32px;
    pointer-events: none;
    z-index: 9999;
    /* We'll set the background image via JavaScript to ensure the path is correct */
    background-image: url('../assets/raspberry-logo.svg');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    transform: translate(-50%, -50%);
}

/* Preloader */
#preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--primary-white);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9998;
}

.loader {
    width: 50px;
    height: 50px;
    border: 5px solid var(--glass-bg);
    border-top-color: var(--primary-red);
    border-radius: 50%;
    animation: spin 1s ease-in-out infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

/* Header/Hero */
#hero {
    position: relative;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: hidden;
    background: var(--primary-white);
}

.hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 1rem;
}

.hero-content h1 {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    color: var(--primary-red);
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
}

.hero-content .tagline {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    color: var(--dark-gray);
    opacity: 0.9;
}

/* Liquid glass effect for hero overlay (if needed) */
#hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    z-index: 1;
    opacity: 0.7;
}

/* Three.js container */
#three-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}

/* Navigation */
#navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border-bottom: 1px solid var(--glass-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    z-index: 1000;
}

.nav-logo {
    color: var(--primary-red);
    font-size: 1.8rem;
    font-weight: bold;
    text-decoration: none;
}

.nav-menu {
    display: flex;
    list-style: none;
}

.nav-menu li {
    margin-left: 2rem;
}

.nav-link {
    color: var(--dark-gray);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
}

.nav-link:hover {
    color: var(--primary-red);
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--primary-red);
    transition: width 0.3s ease;
}

.nav-link:hover::after {
    width: 100%;
}

/* Hamburger menu */
.nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 25px;
    height: 20px;
    cursor: pointer;
}

.nav-hamburger span {
    background-color: var(--dark-gray);
    height: 3px;
    border-radius: 2px;
}

/* Mobile menu */
#nav-mobile {
    display: none;
    position: fixed;
    top: 0;
    right: -100%;
    height: 100vh;
    width: 250px;
    background-color: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border-left: 1px solid var(--glass-border);
    flex-direction: column;
    align-items: center;
    padding-top: 5rem;
    transition: right 0.3s ease;
    z-index: 1001;
}

#nav-mobile.active {
    right: 0;
}

#nav-mobile ul {
    list-style: none;
}

#nav-mobile li {
    margin: 1.5rem 0;
}

#nav-mobile a {
    color: var(--primary-white);
    text-decoration: none;
    font-size: 1.2rem;
}

/* Sections */
.section {
    padding: 5rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
}

.section-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 3rem;
    color: var(--primary-red);
    position: relative;
}

.section-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 50px;
    height: 4px;
    background-color: var(--primary-red);
}

/* Features */
.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
}

.feature-card {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    padding: 2rem;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.feature-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
}

.feature-card h3 {
    color: var(--primary-red);
    margin-bottom: 1rem;
    font-size: 1.5rem;
}

/* Gallery */
.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
}

.gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    cursor: pointer;
}

.gallery-item img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s ease;
}

.gallery-item:hover img {
    transform: scale(1.05);
}

.overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border-top: 1px solid var(--glass-border);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: height 0.3s ease;
}

.gallery-item:hover .overlay {
    height: 60px;
}

.overlay h3 {
    color: var(--primary-white);
    font-size: 1.2rem;
}

/* About */
.about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
}

.about-text p {
    margin-bottom: 1.5rem;
    line-height: 1.6;
    font-size: 1.1rem;
}

.about-image img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
}

/* Contact */
.contact-form {
    max-width: 600px;
    margin: 0 auto;
    display: grid;
    gap: 2rem;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: var(--primary-red);
}

.form-group input,
.form-group textarea {
    padding: 0.75rem;
    border: 1px solid var(--light-gray);
    border-radius: 5px;
    font-family: inherit;
    font-size: 1rem;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.form-group input:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--primary-red);
    box-shadow: 0 0 0 3px rgba(255,0,0,0.2);
}

.btn-submit {
    background-color: var(--primary-red);
    color: var(--primary-white);
    border: none;
    padding: 1rem 2rem;
    font-size: 1.1rem;
    font-weight: bold;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.1s ease;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}

.btn-submit:hover {
    background-color: #e60000;
    box-shadow: 0 6px 12px rgba(0,0,0,0.15);
}

.btn-submit:active {
    transform: scale(0.98);
}

/* Footer */
#footer {
    background-color: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border-top: 1px solid var(--glass-border);
    text-align: center;
    padding: 2rem 0;
    font-size: 0.9rem;
    color: var(--primary-white);
}

.footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
}

.social-links a {
    color: var(--primary-white);
    text-decoration: none;
    margin: 0 0.5rem;
    font-weight: 500;
    transition: color 0.3s ease;
}

.social-links a:hover {
    color: var(--primary-red);
}

.astria-label {
    font-size: 2.5rem;
    color: var(--primary-red);
    font-weight: bold;
    margin: 0;
    text-align: center;
}

.pi-placeholder {
    max-width: 80%;
    height: auto;
    display: block;
    margin: 30px auto;
    border: 2px dashed var(--primary-red);
    border-radius: 10px;
    padding: 20px;
    background-color: rgba(255,255,255,0.05);
}

.astria-info {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
}

.discord-logo-img {
    width: 36px;
    height: 36px;
}

/* Responsive Design */
@media (max-width: 768px) {
    .hero-content h1 {
        font-size: 2.5rem;
    }

    .hero-content .tagline {
        font-size: 1.2rem;
    }

    .about-content {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .nav-menu {
        display: none;
    }

    .nav-hamburger {
        display: flex;
    }
}

/* Animation classes for ScrollTrigger */
.fade-up {
    opacity: 0;
    transform: translateY(30px);
}

.fade-up.active {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s ease, transform 0.6s ease;
}



#astria-lab-section {
    margin: 2rem auto;
    max-width: 600px;
}


#astria-overlay {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 9999;
    pointer-events: none;
    text-align: center;
    color: var(--primary-white);
}

